# Memory Studio — Environment Variables Template
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored (see .gitignore).
#
# Variables prefxed with MEMORY_STUDIO_ are read by the Memory Studio
# server (Fastify) and SDK at boot. Other variables (e.g. ANTHROPIC_*
# for the parent LLM in Claude Code) are NOT consumed by Memory Studio.

## ── Fast agent (Phase 6b — Inception Híbrida) ────────────────────
## Required: MiniMax API key for the in-process fast agent that reads
## R_N in parallel with the human, generating `intel` for Turn N+1.
##
## Default model: MiniMax-M2.7-highspeed (no Claude Code, "Haiku" option
## aliases to this model — verified 2026-07-28).
## Default base URL: https://api.minimax.io/anthropic
##
## Get a key from https://api.minimax.io (or copy from your Claude Code
## env — same MiniMax key works for both).
MEMORY_STUDIO_FAST_AGENT_API_KEY=

## Optional: override the default fast agent model.
## Default: MiniMax-M2.7-highspeed
## MEMORY_STUDIO_FAST_AGENT_MODEL=MiniMax-M2.7-highspeed

## Optional: override the Anthropic-compatible base URL.
## Default: https://api.minimax.io/anthropic
## MEMORY_STUDIO_FAST_AGENT_BASE_URL=https://api.minimax.io/anthropic


## ── Server (Phase 5 — Proxy + Audit) ───────────────────────────────
## Optional: bind address. Default: 127.0.0.1 (localhost only — proxy
## does NOT expose data outside the machine per PRD §10.3.4).
## MEMORY_STUDIO_HOST=127.0.0.1

## Optional: preferred port. Default: first free port from 41823.
## MEMORY_STUDIO_PORT=41823

## Optional: SQLite database file. Default: ./.memory-studio/data.db
## MEMORY_STUDIO_DB_PATH=./.memory-studio/data.db

## Optional: catalog YAML directory. Default: ./config/catalog
## MEMORY_STUDIO_CATALOG_PATH=./config/catalog

## Optional: state file. Default: ./.memory-studio/state.json
## MEMORY_STUDIO_STATE_PATH=./.memory-studio/state.json


## ── Embedding (Phase 1 — Catalog + Schema + Index) ─────────────────
## Optional: path to multilingual-e5-small ONNX model.
## Default: ./models/multilingual-e5-small.onnx
## MEMORY_STUDIO_EMBEDDING_MODEL_PATH=./models/multilingual-e5-small.onnx

## Optional: embedding dimensions. Default: 384 (multilingual-e5-small).
## MEMORY_STUDIO_EMBEDDING_DIMS=384


## ── Tunables (override PRD §10 / state.json defaults) ──────────────
## Optional: minimum cosine similarity for retrieval match.
## Default: 0.6 (initial threshold committed in Phase 1 done criteria).
## MEMORY_STUDIO_MIN_COSINE_SIMILARITY=0.6

## Optional: minimum FTS5 hits for retrieval match.
## Default: 2
## MEMORY_STUDIO_MIN_FTS_HITS=2

## Optional: audit log buffer flush interval (ms). Default: 1000.
## MEMORY_STUDIO_AUDIT_FLUSH_MS=1000

## Optional: audit log buffer max events before flush. Default: 100.
## MEMORY_STUDIO_AUDIT_FLUSH_EVENTS=100