{
  "name": "memory-studio",
  "version": "0.0.0",
  "description": "Context injection tool for code agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test/**/*.test.mjs",
    "test:smoke": "node --test test/smoke.test.mjs",
    "test:idempotent": "npm test && npm test",
    "test:catalog": "node --test test/catalog/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/search/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build-index": "node --experimental-strip-types --no-warnings scripts/build-index.ts",
    "catalog:load": "node --experimental-strip-types --no-warnings scripts/build-index.ts",
    "verify-env": "node scripts/verify-env.mjs",
    "server:start": "node --env-file=.env --experimental-strip-types --no-warnings src/server/boot.ts",
    "ui:start": "node --experimental-strip-types --no-warnings scripts/ui-server.mjs",
    "inception:enable": "node scripts/inception.mjs enable",
    "inception:disable": "node scripts/inception.mjs disable",
    "inception:status": "node scripts/inception.mjs status",
    "smoke:augment-server": "node scripts/smoke-augment-server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.11.0",
    "onnxruntime-node": "^1.27.0",
    "pino": "^9.5.0",
    "sqlite-vec": "^0.1.9",
    "yaml": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
