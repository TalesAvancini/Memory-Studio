      "col": 1,
      "tag": "engine"
    },
    {
      "id": "sqlite-vec",
      "type": "database",
      "label": "sqlite-vec",
      "sublabel": "vector engine 384d",
      "row": 0,
      "col": 2,
      "tag": "engine"
    },
    {
      "id": "embedding-model",
      "type": "cloud",
      "label": "Embedding Model",
