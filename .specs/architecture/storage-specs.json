          1220,
          80
        ],
        [
          180,
          80
        ]
      ]
    },
    {
      "from": "sqlite",
      "to": "sqlite-fts5",
      "label": "FTS5 virtual table",
      "route": "orthogonal-v",
      "via": [
        [
          180,
          80
        ],
        [
          640,
          80
        ]
      ]
    },
    {
      "from": "sqlite",
      "to": "sqlite-vec",
      "label": "vec virtual table"
    },
    {
      "from": "embedding-model",
      "to": "sqlite-vec",
      "label": "writes 384d vectors"
